custom_round <- function(x) {
rounded <- ifelse(x - floor(x) > 0.50, ceiling(x),  # .51+ rounds up
floor(x))                            # .50 and below rounds down
rounded <- ifelse(rounded < 1, 1, rounded)            # anything under 1 becomes 1
return(rounded)
}
predictions_rounded <- custom_round(predictions)
head(predictions)
predictions
