)
encounters = encounters %>% mutate(
AdmitDateTime = make_datetime(AdmitYear, AdmitMonth, AdmitDay, AdmitHour, AdmitMinute),
DischargeDateTime = make_datetime(DischargeYear, DischargeMonth, DischargeDay, DischargeHour, DischargeMinute)
)
encounter_timeline <- encounters %>%
left_join(social, by = c("EncounterKey", "PatientDurableKey")) %>%
arrange(PatientDurableKey, AdmitDateTime) %>%
group_by(PatientDurableKey) %>%
mutate(
gap_days = as.numeric(difftime(AdmitDateTime,
lag(AdmitDateTime),
units = "days")),
encounter_number = row_number()
) %>%
ungroup()
patient_features <- encounter_timeline %>%
group_by(PatientDurableKey) %>%
summarise(
avg_gap_days     = mean(gap_days, na.rm = TRUE),
median_gap_days  = median(gap_days, na.rm = TRUE),
max_gap_days     = max(gap_days, na.rm = TRUE),
total_encounters = n(),
journey_duration = as.numeric(difftime(max(AdmitDateTime),
min(AdmitDateTime),
units = "days")),
encounter_freq   = total_encounters / (journey_duration + 1)  # per day
)
