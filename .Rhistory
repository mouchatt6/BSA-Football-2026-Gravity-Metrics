encounter_timeline <- encounters %>%
# Join with DS5 to get patient key
left_join(encounter_patient, by = "encounter_key") %>%
arrange(patient_durable_key, admit_datetime) %>%
group_by(patient_durable_key) %>%
mutate(
gap_days = as.numeric(difftime(admit_datetime,
lag(admit_datetime),  # previous encounter
units = "days")),
encounter_number = row_number()
) %>%
ungroup()
